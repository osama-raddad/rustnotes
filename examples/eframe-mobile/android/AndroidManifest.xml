<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal NativeActivity manifest for an eframe app. No Java/Kotlin:
     android.app.NativeActivity (part of the OS) loads libmobile_app.so
     and calls android_main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobileapp">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <application
        android:label="Mobile App"
        android:hasCode="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="android.app.NativeActivity"
            android:label="Mobile App"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">

            <!-- Which native library NativeActivity should dlopen. -->
            <meta-data android:name="android.app.lib_name" android:value="mobile_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
