<?xml version="1.0" encoding="utf-8"?>
<!-- GameActivity variant of AndroidManifest.xml — the opt-in backend
     (justfile: activity=game; cargo: the android-game-activity feature).
     Diff vs the NativeActivity manifest is exactly the backend's needs,
     mirroring hello-mobile's game manifest: the activity class (GameActivity
     ships as Java — androidx.games:games-activity 4.4.0, dexed into the
     APK, so hasCode flips to true) and its short configChanges list.
     Everything else is the same matched set: package, label, icon,
     extractNativeLibs, adjustResize and the android.app.lib_name meta-data
     (GameActivity reads the same name to load the cdylib). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.demomobile"
    android:versionCode="1"
    android:versionName="0.1.0">

    <application
        android:label="Demo Mobile"
        android:icon="@android:drawable/sym_def_app_icon"
        android:hasCode="true"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">

            <!-- Same matched-set rule as the NativeActivity manifest above. -->
            <meta-data android:name="android.app.lib_name" android:value="demo_mobile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
